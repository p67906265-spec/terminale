<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matrix_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terminale"
            android:textColor="@color/matrix_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:id="@+id/textConnectionSubtitle"
            android:text="Connessione SSH locale"
            android:textColor="@color/matrix_cyan"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_matrix"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accesso protetto"
                android:textColor="@color/matrix_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Inserisci i dati del server Linux"
                android:textColor="@color/matrix_text_secondary"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/radioConnectionMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioLocal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/matrix_cyan"
                    android:text="Locale"
                    android:textColor="@color/matrix_text_primary" />

                <RadioButton
                    android:id="@+id/radioTailscale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/matrix_cyan"
                    android:text="Tailscale"
                    android:textColor="@color/matrix_text_primary" />
            </RadioGroup>

            <TextView
                android:id="@+id/textConnectionHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Usa l'IP locale del server."
                android:textColor="@color/matrix_text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:autofillHints=""
                android:background="@drawable/bg_input_matrix"
                android:hint="Indirizzo IP"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="@color/matrix_text_primary"
                android:textColorHint="@color/matrix_text_secondary" />

            <EditText
                android:id="@+id/editPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_matrix"
                android:hint="Porta (default 22)"
                android:inputType="number"
                android:padding="14dp"
                android:textColor="@color/matrix_text_primary"
                android:textColorHint="@color/matrix_text_secondary" />

            <EditText
                android:id="@+id/editUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints=""
                android:background="@drawable/bg_input_matrix"
                android:hint="Nome utente"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="@color/matrix_text_primary"
                android:textColorHint="@color/matrix_text_secondary" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints=""
                android:background="@drawable/bg_input_matrix"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="@color/matrix_text_primary"
                android:textColorHint="@color/matrix_text_secondary" />

            <CheckBox
                android:id="@+id/checkSavePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/matrix_cyan"
                android:text="Salva password cifrata sul dispositivo"
                android:textColor="@color/matrix_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonConnect"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_matrix"
                android:drawableStart="@drawable/ic_matrix_connect"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Connetti"
                android:textAllCaps="false"
                android:textColor="@color/matrix_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:indeterminateTint="@color/matrix_cyan"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/matrix_error" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
