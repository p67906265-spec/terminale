<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_matrix"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/matrix_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textCommand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/matrix_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonEdit"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:background="@drawable/bg_button_matrix_small"
        android:drawableStart="@drawable/ic_matrix_edit"
        android:drawablePadding="4dp"
        android:text="Modifica"
        android:textAllCaps="false"
        android:textColor="@color/matrix_text_primary"
        android:textSize="11sp" />

    <Button
        android:id="@+id/buttonDelete"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_button_matrix_small"
        android:drawableStart="@drawable/ic_matrix_delete"
        android:drawablePadding="4dp"
        android:text="Elimina"
        android:textAllCaps="false"
        android:textColor="@color/matrix_text_primary"
        android:textSize="11sp" />
</LinearLayout>
